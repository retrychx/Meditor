@@ -0,0 +1,42 @@
+import Foundation
+
+/// A reusable prompt fragment that users can insert into their own skills.
+struct SkillSnippet: Identifiable, Codable {
+    let id: UUID
+    var title: String
+    var body: String
+    var tags: [String]
+}
+
+enum SkillSnippetStore {
+    private static let key = "MEditor.skillSnippets"
+
+    static func load() -> [SkillSnippet] {
+        guard let data = UserDefaults.standard.data(forKey: key),
+              let decoded = try? JSONDecoder().decode([SkillSnippet].self, from: data)
+        else { return [] }
+        return decoded
+    }
+
+    static func save(_ snippets: [SkillSnippet]) {
+        if let data = try? JSONEncoder().encode(snippets) {
+            UserDefaults.standard.set(data, forKey: key)
+        }
+    }
+}
